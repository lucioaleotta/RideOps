# =============================================================================
# RideOps – Variabili d'ambiente PRODUZIONE
# Copia in /opt/rideops/.env sul server e NON committare mai questo file!
# =============================================================================

# ── GitHub Container Registry (GHCR) ─────────────────────────────────────────
# GHCR_USER = tuo username GitHub (es. lucioaleotta)
GHCR_USER=il_tuo_username_github
# GHCR_TOKEN = Personal Access Token GitHub con scope read:packages
# Genera su: https://github.com/settings/tokens/new?scopes=read:packages
GHCR_TOKEN=il_tuo_github_pat
# Prefisso immagini GHCR (NON modificare se usi lucioaleotta/RideOps)
GHCR_IMAGE_PREFIX=ghcr.io/lucioaleotta
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=rideops
POSTGRES_USER=rideops
# Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD_SICURA

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 48
JWT_SECRET=CAMBIA_QUESTO_SECRET_LUNGO_E_CASUALE
JWT_EXPIRATION_SECONDS=3600

# ── Admin iniziale ────────────────────────────────────────────────────────────
ADMIN_USER_ID=admin
ADMIN_EMAIL=admin@rideops.it
# Genera con: openssl rand -base64 16
ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_ADMIN

# ── URL pubbliche applicazione ───────────────────────────────────────────────
RIDEOPS_PUBLIC_URL=https://rideops.it
RIDEOPS_LOGIN_URL=https://rideops.it/login

# ── Brevo ───────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@rideops.it
BREVO_SENDER_NAME=RideOps
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_REPLY_TO=support@rideops.it

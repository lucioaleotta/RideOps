# =============================================================================
# RideOps — Variabili di produzione
# =============================================================================
# ISTRUZIONI:
#   1. Copia questo file: cp .env.prod.example .env
#   2. Compila tutti i valori
#   3. chmod 600 /opt/rideops/.env   (solo l'owner può leggere)
#   4. NON committare mai il file .env nel repository!
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=rideops
POSTGRES_USER=rideops
# Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD_SICURA

# ── Backend ───────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET=CAMBIA_QUESTO_SECRET_JWT_MOLTO_LUNGO_E_CASUALE
JWT_EXPIRATION_SECONDS=3600

# Credenziali admin iniziali (cambiarle subito dopo il primo login)
ADMIN_EMAIL=admin@rideops.it
ADMIN_PASSWORD=CAMBIA_ANCHE_QUESTA_PASSWORD!

# ── Docker Images ─────────────────────────────────────────────────────────────
# Formato: ghcr.io/<github-username>/rideops-backend:<tag>
DOCKER_IMAGE_BACKEND=ghcr.io/lucioaleotta/rideops-backend:latest
DOCKER_IMAGE_FRONTEND=ghcr.io/lucioaleotta/rideops-frontend:latest
